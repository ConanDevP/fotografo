generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String           @unique
  passwordHash              String?          @map("password_hash")
  name                      String?          @map("name")
  phone                     String?          @map("phone")
  profileImageUrl           String?          @map("profile_image_url")
  address                   String?          @map("address")
  role                      UserRole
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  slug                      String?          @unique
  bio                       String?
  website                   String?
  instagram                 String?
  facebook                  String?
  specialties               String[]
  experienceYears           Int?             @map("experience_years")
  location                  String?
  portfolioUrl              String?          @map("portfolio_url")
  isFeatured                Boolean          @default(false) @map("is_featured")
  isVerified                Boolean          @default(false) @map("is_verified")
  paypalMerchantId          String?          @unique @map("paypal_merchant_id")
  paypalMerchantIdInPayPal  String?          @map("paypal_merchant_id_in_paypal")
  paypalEmail               String?          @map("paypal_email")
  paypalOnboardingCompleted Boolean          @default(false) @map("paypal_onboarding_completed")
  paypalPermissionsGranted  Boolean          @default(false) @map("paypal_permissions_granted")
  paypalTrackingId          String?          @map("paypal_tracking_id")
  paypalOnboardedAt         DateTime?        @map("paypal_onboarded_at") @db.Timestamptz(6)
  stripeAccountId           String?          @unique @map("stripe_account_id")
  stripeAccountStatus       String?          @map("stripe_account_status")
  stripeOnboardingCompleted Boolean          @default(false) @map("stripe_onboarding_completed")
  stripeChargesEnabled      Boolean          @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled      Boolean          @default(false) @map("stripe_payouts_enabled")
  stripeOnboardedAt         DateTime?        @map("stripe_onboarded_at") @db.Timestamptz(6)
  auditLogs                 AuditLog[]
  BatchUploadJob            BatchUploadJob[]
  ownedEvents               Event[]          @relation("EventOwner")
  orders                    Order[]
  photographedPhotos        Photo[]          @relation("PhotoPhotographer")

  @@index([slug])
  @@index([role, isFeatured])
  @@map("users")
}

model Event {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String               @unique
  date                DateTime             @db.Date
  location            String?
  imageUrl            String?              @map("image_url")
  ownerId             String?              @map("owner_id") @db.Uuid
  bibRules            Json?                @map("bib_rules")
  pricing             Json?                @map("pricing")
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  platformFeePercent  Decimal?             @default(15.00) @map("platform_fee_percent") @db.Decimal(5, 2)
  isFreeDownload      Boolean              @default(false) @map("is_free_download")
  freeDownloadUntil   DateTime?            @map("free_download_until") @db.Timestamptz(6)
  requireEmailForFree Boolean              @default(true) @map("require_email_for_free")
  freeDownloadLimit   Int?                 @map("free_download_limit")
  totalFreeDownloads  Int                  @default(0) @map("total_free_downloads")
  athleteSignatures   AthleteSignature[]
  BatchUploadJob      BatchUploadJob[]
  bibSubscriptions    BibSubscription[]
  owner               User?                @relation("EventOwner", fields: [ownerId], references: [id])
  faceBibAssociations FaceBibAssociation[]
  faceEmbeddings      FaceEmbedding[]
  freeDownloads       FreeDownload[]
  inferredBibs        InferredBib[]
  orders              Order[]
  photoBibs           PhotoBib[]
  photos              Photo[]

  @@map("events")
}

model Photo {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId             String               @map("event_id") @db.Uuid
  photographerId      String?              @map("photographer_id") @db.Uuid
  cloudinaryId        String               @map("cloudinary_id")
  originalUrl         String               @map("original_url")
  thumbUrl            String?              @map("thumb_url")
  watermarkUrl        String?              @map("watermark_url")
  width               Int?
  height              Int?
  takenAt             DateTime?            @map("taken_at") @db.Timestamptz(6)
  status              PhotoStatus          @default(PENDING)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  batchJobId          String?              @map("batch_job_id") @db.Uuid
  auditLogs           AuditLog[]
  faceBibAssociations FaceBibAssociation[]
  faces               FaceEmbedding[]
  freeDownloads       FreeDownload[]
  inferredBibs        InferredBib[]
  orderItems          OrderItem[]
  bibs                PhotoBib[]
  batchJob            BatchUploadJob?      @relation(fields: [batchJobId], references: [id])
  event               Event                @relation(fields: [eventId], references: [id])
  photographer        User?                @relation("PhotoPhotographer", fields: [photographerId], references: [id])

  @@index([eventId])
  @@map("photos")
}

model PhotoBib {
  id                  BigInt               @id @default(autoincrement())
  photoId             String               @map("photo_id") @db.Uuid
  eventId             String               @map("event_id") @db.Uuid
  bib                 String
  confidence          Decimal              @db.Decimal(4, 3)
  bbox                Json?
  source              String               @default("GEMINI")
  promptTokens        Int?                 @map("prompt_tokens")
  candidatesTokens    Int?                 @map("candidates_tokens")
  totalTokens         Int?                 @map("total_tokens")
  geminiImageWidth    Int?                 @map("gemini_image_width")
  geminiImageHeight   Int?                 @map("gemini_image_height")
  faceBibAssociations FaceBibAssociation[]
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photo               Photo                @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([eventId, bib], map: "idx_bibs_event_bib")
  @@map("photo_bibs")
}

model BibSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  bib       String
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event     Event    @relation(fields: [eventId], references: [id])

  @@map("bib_subscriptions")
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  eventId         String?     @map("event_id") @db.Uuid
  amountCents     Int         @map("amount_cents")
  currency        String      @default("USD")
  status          OrderStatus
  stripeSessionId String?     @map("stripe_session_id")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  items           OrderItem[]
  event           Event?      @relation(fields: [eventId], references: [id])
  user            User?       @relation(fields: [userId], references: [id])

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  photoId    String?  @map("photo_id") @db.Uuid
  itemType   ItemType @map("item_type")
  priceCents Int      @map("price_cents")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photo      Photo?   @relation(fields: [photoId], references: [id])

  @@map("order_items")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  photoId   String?  @map("photo_id") @db.Uuid
  action    String
  data      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  photo     Photo?   @relation(fields: [photoId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model FaceEmbedding {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  photoId             String               @map("photo_id") @db.Uuid
  eventId             String               @map("event_id") @db.Uuid
  embedding           Float[]              @map("embedding")
  confidence          Decimal              @db.Decimal(4, 3)
  bbox                Json?                @map("bounding_box")
  landmarks           Json?                @map("landmarks")
  age                 Int?                 @map("estimated_age")
  gender              String?              @map("estimated_gender")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  faceBibAssociations FaceBibAssociation[]
  event               Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photo               Photo                @relation(fields: [photoId], references: [id], onDelete: Cascade)
  inferredBibs        InferredBib[]

  @@index([eventId], map: "idx_face_embeddings_event")
  @@index([photoId], map: "idx_face_embeddings_photo")
  @@map("face_embeddings")
}

model BatchUploadJob {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status           BatchUploadStatus @default(PENDING)
  totalFiles       Int
  uploadedFiles    Int               @default(0)
  processedFiles   Int               @default(0)
  ownerId          String            @map("owner_id") @db.Uuid
  eventId          String            @map("event_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  faceFiles        Int               @default(0) @map("face_files")
  failedFaces      Int               @default(0) @map("failed_faces")
  failedGemini     Int               @default(0) @map("failed_gemini")
  failedWatermarks Int               @default(0) @map("failed_watermarks")
  geminiFiles      Int               @default(0) @map("gemini_files")
  watermarkFiles   Int               @default(0) @map("watermark_files")
  event            Event             @relation(fields: [eventId], references: [id])
  owner            User              @relation(fields: [ownerId], references: [id])
  photos           Photo[]

  @@map("batch_upload_jobs")
}

model FreeDownload {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  photoId      String   @map("photo_id") @db.Uuid
  email        String?
  name         String?
  phone        String?
  bibNumber    String?  @map("bib_number")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  referer      String?
  country      String?
  city         String?
  downloadedAt DateTime @default(now()) @map("downloaded_at") @db.Timestamptz(6)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photo        Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([photoId])
  @@index([email])
  @@index([downloadedAt])
  @@map("free_downloads")
}

model FaceBibAssociation {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  faceEmbeddingId String        @map("face_embedding_id") @db.Uuid
  photoBibId      BigInt        @map("photo_bib_id")
  photoId         String        @map("photo_id") @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  bib             String
  spatialScore    Decimal       @db.Decimal(4, 3)
  method          String        @default("SPATIAL")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  faceEmbedding   FaceEmbedding @relation(fields: [faceEmbeddingId], references: [id], onDelete: Cascade)
  photoBib        PhotoBib      @relation(fields: [photoBibId], references: [id], onDelete: Cascade)
  photo           Photo         @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([faceEmbeddingId, photoBibId])
  @@index([eventId, bib], map: "idx_face_bib_assoc_event_bib")
  @@index([photoId], map: "idx_face_bib_assoc_photo")
  @@map("face_bib_associations")
}

model AthleteSignature {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  bib           String
  faceSignature Float[]  @map("face_signature")
  sampleCount   Int      @default(1)
  confidence    Decimal  @db.Decimal(4, 3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, bib])
  @@index([eventId], map: "idx_athlete_signature_event")
  @@map("athlete_signatures")
}

model InferredBib {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  photoId         String        @map("photo_id") @db.Uuid
  faceEmbeddingId String        @map("face_embedding_id") @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  bib             String
  confidence      Decimal       @db.Decimal(4, 3)
  faceDistance    Decimal       @db.Decimal(4, 3)
  inferredFrom    String        @map("inferred_from")
  verified        Boolean       @default(false)
  rejected        Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  faceEmbedding   FaceEmbedding @relation(fields: [faceEmbeddingId], references: [id], onDelete: Cascade)
  photo           Photo         @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([faceEmbeddingId, bib])
  @@index([photoId], map: "idx_inferred_bib_photo")
  @@index([eventId, bib], map: "idx_inferred_bib_event_bib")
  @@index([eventId, verified], map: "idx_inferred_bib_event_verified")
  @@map("inferred_bibs")
}

enum UserRole {
  ATHLETE
  PHOTOGRAPHER
  ADMIN
}

enum PhotoStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OrderStatus {
  CREATED
  PAID
  CANCELLED
  REFUNDED
}

enum ItemType {
  PHOTO
  PACKAGE
}

enum BatchUploadStatus {
  PENDING
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}
