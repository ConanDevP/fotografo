  @@unique([faceEmbeddingId, bib])
  @@index([photoId], map: "idx_inferred_bib_photo")
  @@index([eventId, bib], map: "idx_inferred_bib_event_bib")
  @@index([eventId, verified], map: "idx_inferred_bib_event_verified")
  @@map("inferred_bibs")
}

