// ─────────────────────────────────────────────────────────────────────────────
// Facturación: planes, suscripción y consumo de almacenamiento
//
// El modelo tiene un solo medidor (bytes almacenados) y una sola comisión
// (porcentaje sobre cada foto vendida). Un espacio que vende paga comisión; un
// espacio que regala fotos paga el plan que cubra su almacenamiento. La cuota
// por evento solo aplica a eventos regalados con patrocinadores, donde sí entra
// dinero de marca.
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String         @unique
  name                   String
  audience               PlanAudience   @default(ANY)
  description            String?
  priceCents             Int            @default(0) @map("price_cents")
  currency               String         @default("USD")
  /// Comisión que retiene la plataforma por cada fotografía vendida.
  commissionPercent      Decimal        @map("commission_percent") @db.Decimal(5, 2)
  /// Almacenamiento incluido en el plan.
  includedStorageBytes   BigInt         @map("included_storage_bytes")
  /// Ampliación opcional: tamaño y precio de cada bloque adicional.
  extraStorageBlockBytes BigInt?        @map("extra_storage_block_bytes")
  extraStorageBlockCents Int?           @map("extra_storage_block_cents")
  /// Modo compartir: céntimos por fotografía subida a un evento de descarga
  /// gratuita. Admite decimales porque las tarifas bajan de un céntimo por foto.
  sharePhotoCents        Decimal        @default(0) @map("share_photo_cents") @db.Decimal(8, 4)
  /// Cuota por publicar un evento de descarga gratuita con patrocinadores.
  sponsoredEventFeeCents Int            @default(0) @map("sponsored_event_fee_cents")
  maxAdmins              Int?           @map("max_admins")
  allowsCustomDomain     Boolean        @default(false) @map("allows_custom_domain")
  allowsSponsors         Boolean        @default(false) @map("allows_sponsors")
  allowsAdvancedMetrics  Boolean        @default(false) @map("allows_advanced_metrics")
  isActive               Boolean        @default(true) @map("is_active")
  isDefault              Boolean        @default(false) @map("is_default")
  sortOrder              Int            @default(0) @map("sort_order")
  stripePriceId          String?        @unique @map("stripe_price_id")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions          Subscription[]

  @@index([audience, isActive, sortOrder])
  @@map("plans")
}

model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String             @unique @map("workspace_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(ACTIVE)
  /// Bloques de almacenamiento adicionales contratados sobre el plan.
  extraStorageBlocks   Int                @default(0) @map("extra_storage_blocks")
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@index([planId, status])
  @@map("subscriptions")
}

enum PlanAudience {
  PHOTOGRAPHER
  ORGANIZER
  ANY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}
