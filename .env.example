# API Configuration
PORT=8080
NODE_ENV=development
PARTNER_WEBHOOK_ENCRYPTION_KEY=development-only-change-in-production
API_URL="http://localhost:8080"
TRUST_PROXY_HOPS=1
PLATFORM_DOMAINS="lucilamon.com,www.lucilamon.com"
ACME_EMAIL="admin@lucilamon.com"

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE - Neon PostgreSQL (Recommended for production)
# ═══════════════════════════════════════════════════════════════════════════════
# 
# Neon provides serverless PostgreSQL with:
# - Autoscaling (handles 10K+ photo uploads)
# - Connection pooling built-in
# - pgvector for face embeddings
# - Branching for dev/staging
#
# Get your connection string from: https://console.neon.tech
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
#
# IMPORTANT: Use the "Pooled connection" string for your app
# The pooled connection uses port 5432 and handles connection limits automatically
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
POSTGRES_PASSWORD="replace-with-a-long-random-password"

# For local development with Docker (optional)
# DATABASE_URL="postgresql://fotografos_user:fotografos_pass@localhost:5432/fotografos_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Cloudinary (Legacy - mantenido para compatibilidad)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_SECURE=true

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="fotografos-images"
R2_PUBLIC_BUCKET_NAME="fotografos-public"
R2_PUBLIC_URL=""

# Storage Provider (cloudinary|r2)
STORAGE_PROVIDER="r2"

# Python Face Recognition API
PYTHON_FACE_API_URL="http://localhost:8000"
FACE_API_KEY="replace-with-a-long-random-secret"
# Candidatos que devuelve el índice HNSW por búsqueda facial. Ya no es un
# techo del evento: con pgvector el filtrado ocurre dentro de Postgres.
FACE_SEARCH_MAX_CANDIDATES=200

# Gemini AI
GEMINI_API_KEY=""
GEMINI_FLASH_MODEL="gemini-2.5-flash-lite"
GEMINI_PRO_MODEL="gemini-2.5-pro"

# Payment Gateways

# PayPal (modo básico - sin platform/marketplace)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# Stripe Connect (marketplace - pagos directos a fotógrafos)
# Obtén tus keys en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""                    # sk_test_xxx o sk_live_xxx
STRIPE_PUBLISHABLE_KEY=""               # pk_test_xxx o pk_live_xxx
STRIPE_WEBHOOK_SECRET=""                # whsec_xxx (para verificar webhooks)

# Stripe Connect usa "Express" accounts para fotógrafos
# Los fotógrafos completan onboarding y reciben pagos directamente
# La plataforma cobra una comisión (platformFeePercent en Event)

# MercadoPago (próximamente)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Email
EMAIL_FROM="noreply@lucilamon.com"
EMAIL_SERVICE="sendgrid"
SENDGRID_API_KEY=""
# Para SMTP usa EMAIL_SERVICE="smtp" y configura:
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Demo Mode
DEMO_PAYMENTS=false

# Security
BCRYPT_ROUNDS=12
ORDER_ACCESS_SECRET="replace-with-at-least-32-random-bytes"
METRICS_HASH_SECRET="replace-with-a-different-32-byte-random-secret"
ADMIN_SECRET_KEY=""
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Frontend URL
FRONTEND_URL="http://localhost:3000"
# Orígenes autorizados para la API y, con el mismo valor, para la subida
# directa a R2. Tras cambiar esta lista hay que reaplicar la política del
# bucket: node scripts/set-r2-cors.js
CORS_ORIGINS="https://lucilamon.com,https://www.lucilamon.com,http://localhost:3000"

# Monitoring
SENTRY_DSN=""
LOG_LEVEL="info"
