# ─────────────────────────────────────────────────────────────────────────────
# Producción. Copia este archivo, rellénalo y despliégalo como .env
#
# El arranque valida esta configuración (apps/api/src/common/config/
# validate-environment.ts) y SE NIEGA a levantar si algo falta. Es a propósito:
# es preferible no arrancar que arrancar cobrando mal.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080

# Dominios reales, siempre HTTPS. API_URL es además el destino del webhook de
# Stripe, así que no puede ser un túnel temporal.
API_URL="https://api.lucilamon.com"
FRONTEND_URL="https://www.lucilamon.com"
CORS_ORIGINS="https://lucilamon.com,https://www.lucilamon.com"

# Neon: usa SIEMPRE el endpoint con "-pooler" y añade estos parámetros.
# Sin pgbouncer=true, Prisma usa sentencias preparadas que PgBouncer en modo
# transacción no conserva, y fallan de forma intermitente bajo carga.
# connection_limit bajo porque el pool de Prisma se apila sobre el de Neon.
# ...?sslmode=require&pgbouncer=true&connection_limit=5&connect_timeout=15
DATABASE_URL="postgresql://usuario:clave@host/base?sslmode=require"
REDIS_URL="rediss://host:6379"

# Par RSA para firmar sesiones. Genéralo NUEVO para producción; no reutilices el
# de desarrollo, y menos si alguna vez estuvo en el repositorio.
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Secretos propios. Genera cada uno con: openssl rand -hex 32
# Rotar ORDER_ACCESS_SECRET invalida los enlaces de descarga ya enviados.
ORDER_ACCESS_SECRET=""
METRICS_HASH_SECRET=""
# Cifra los secretos HMAC de webhooks de clientes. Rotarla sin una migración de
# secretos impediría reenviar webhooks de endpoints ya creados.
PARTNER_WEBHOOK_ENCRYPTION_KEY=""

# ── Cobros ───────────────────────────────────────────────────────────────────
# Claves LIVE (sk_live_ / pk_live_), no las de prueba.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Del endpoint que registres en Stripe apuntando a API_URL/v1/webhooks/stripe.
# Sin él no se confirman los pagos: el dinero entra y el pedido nunca se marca
# como pagado.
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_COUNTRY="HN"

# Debe quedarse en false. El arranque lo rechaza si vale true.
DEMO_PAYMENTS=false

# ── Almacenamiento ───────────────────────────────────────────────────────────
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Dos buckets distintos: el privado guarda los originales, el público sirve
# miniaturas y marcas de agua. El arranque rechaza que sean el mismo.
R2_BUCKET_NAME="lucilamon-originales"
R2_PUBLIC_BUCKET_NAME="lucilamon-publico"
R2_PUBLIC_URL="https://cdn.lucilamon.com"

# ── Reconocimiento facial ────────────────────────────────────────────────────
# El mismo valor en el .env del servicio Python, o toda detección da 401.
FACE_API_KEY=""
PYTHON_FACE_API_URL="http://face-api:8000"
FACE_SEARCH_MAX_CANDIDATES=200

GEMINI_API_KEY=""
GEMINI_FLASH_MODEL="gemini-2.5-flash-lite"
GEMINI_PRO_MODEL="gemini-2.5-pro"

# ── Correo (Resend) ──────────────────────────────────────────────────────────
# Sin esta clave los correos no salen: los enlaces de recuperación quedan en el
# log y nadie puede reponer su contraseña.
# El dominio de EMAIL_FROM debe estar verificado en Resend o los rechazará.
RESEND_API_KEY=""
#
# Alternativas heredadas. Solo se usan si RESEND_API_KEY está vacía.
EMAIL_SERVICE="sendgrid"
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@lucilamon.com"
# Alternativa a SendGrid. Solo se usa si SENDGRID_API_KEY está vacía.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Base de los enlaces que salen por correo. Debe apuntar al frontend público.
APP_URL="https://lucilamon.com"

# ── Dominios propios de los fotógrafos ───────────────────────────────────────
# Caddy emite certificados bajo demanda y pregunta a la API si el dominio
# pertenece a un espacio verificado y publicado antes de hacerlo.
ACME_EMAIL=""
PLATFORM_DOMAINS="lucilamon.com, www.lucilamon.com"
#
# IMPORTANTE: el destino al que se pide apuntar el CNAME tiene que existir como
# registro A hacia el servidor donde corre Caddy. Y si el dominio está detrás de
# Cloudflare, ese registro debe quedar en DNS-only (nube gris): proxeado, Caddy
# nunca ve la conexión y no puede emitir el certificado.
NEXT_PUBLIC_CUSTOM_DOMAIN_TARGET="domains.lucilamon.com"

LOG_LEVEL="warn"
